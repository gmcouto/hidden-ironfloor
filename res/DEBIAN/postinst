#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/ironfloor/ironfloor /usr/bin/ironfloor

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/ironfloor.service ]; then
			rm -f /etc/systemd/system/ironfloor.service /usr/lib/systemd/system/ironfloor.service /usr/lib/systemd/user/ironfloor.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/ironfloor/files/systemd/ironfloor.service /usr/lib/systemd/system/ironfloor.service
		# try fix error in Ubuntu 18.04
		# Failed to reload ironfloor.service: Unit ironfloor.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/ironfloor.service:10: Executable path is not absolute: pkill -f "ironfloor --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/ironfloor.service
		fi
		systemctl daemon-reload
		systemctl enable ironfloor
		systemctl start ironfloor
	fi
fi
